{
  "name": "@xano-sdk/password-reset",
  "version": "1.0.0",
  "description": "Token-based password reset: a reset_token table, request and confirm endpoints, and the reset email sent through Resend.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Xano",
  "keywords": [
    "xano",
    "xanosdk",
    "xanoscript",
    "password-reset",
    "backend",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xanots/password-reset.git"
  },
  "homepage": "https://github.com/xanots/password-reset#readme",
  "bugs": {
    "url": "https://github.com/xanots/password-reset/issues"
  },
  "xanosdk": {
    "register": "registerPasswordReset",
    "returns": "handle"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "AGENTS.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "fixture:regen": "tsx scripts/regen-golden.ts",
    "prepublishOnly": "npm run build",
    "release": "npm publish --access public",
    "release:beta": "npm version prerelease --preid=beta -m \"chore(release): %s\" && npm publish --tag beta --access public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@xano/sdk": ">=1.0.0 <2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@xano/sdk": "1.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
